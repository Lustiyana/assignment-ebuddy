{
  "compilerOptions": {
    "target": "ES6",
    "module": "NodeNext",
    "outDir": "./dist",
    "rootDir": "../../",
    "strict": true,
    "esModuleInterop": true,
    "paths": {
      "@shared/*": [
        "../../packages/shared/*"
      ]
    },
    "skipLibCheck": true,
    "resolveJsonModule": true,
  },
  "include": [
    "./**/*"
  ]
}